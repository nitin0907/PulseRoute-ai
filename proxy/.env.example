# PulseRoute Proxy — Environment Variables
# Copy this file to .env for local development.
# In Railway: add these under service → Variables.

# -------------------------------------------------------------------
# REQUIRED
# -------------------------------------------------------------------

# Your IBM Cloud API key.
# Used to obtain an IAM bearer token for Orchestrate calls.
# Create at: https://cloud.ibm.com/iam/apikeys
IBM_IAM_API_KEY=your-ibm-cloud-api-key-here

# -------------------------------------------------------------------
# OPTIONAL (defaults shown)
# -------------------------------------------------------------------

# Port the proxy listens on. Railway sets this automatically.
PORT=4000

# CORS allowed origin. Set to your app.html domain in production.
# Use * for development.
ALLOWED_ORIGIN=*
